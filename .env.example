# Copy to .env.local and fill in. Never commit .env.local.
DATABASE_URL=postgres://hiresense:CHANGE_ME@localhost:5432/hiresense
# 32+ random characters, e.g.  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# auto = try the MiniLM model, fall back to the offline hashing embedder
# transformers = MiniLM only (fails if the model cannot be downloaded)
# hash = offline hashing embedder only (lexical, not truly semantic)
EMBEDDING_PROVIDER=auto
